# Copy to infra/litellm/.env. This file contains no working credentials.
LITELLM_CONFIG_FILE=config.yandex.yaml
LITELLM_MASTER_KEY=
YANDEX_API_KEY=
YANDEX_API_URL=
YANDEX_LITE_MODEL=
YANDEX_MODEL=

# Used only with config.openai.yaml:
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_STANDARD_MODEL=gpt-6.1-sol

# Used only with compose.budgets.yaml. Use a URL-safe DB password.
LITELLM_POSTGRES_PASSWORD=
LITELLM_SALT_KEY=

# NestJS settings (set in the application environment, independently):
# CHAT_MODE=gateway
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LITELLM_API_KEY=<scoped virtual key; master key for local no-DB smoke only>
# EMBEDDING_PROVIDER=<keep your existing provider and embedding settings>
