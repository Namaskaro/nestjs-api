model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  size      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, size])
  @@map("cart_item")
}

model Cart {
  id          String     @id @default(uuid())
  userId      String?    @unique
  cartToken   String?    @unique
  totalAmount Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@map("cart")
}

model StoreKnowledge {
  id String @id @default(uuid())

  key String @unique

  section String
  topic   String?

  question String
  answer   String @db.Text

  notice String? @db.Text

  footnote String? @db.Text

  tags String[] @default([])

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, isActive])
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryProvider {
  EMS
  POSTAL
  BOXBERRY
  SDEK
}

enum ConversationMessageRole {
  USER
  ASSISTANT
  OPERATOR
}

enum UserGender {
  MAN    @map("MAN")
  WOMAN  @map("WOMAN")
  UNISEX @map("UNISEX")
}

enum ProductType {
  SHOES       @map("SHOES")
  CLOTHES     @map("CLOTHES")
  ACCESSORIES @map("ACCESSORIES")
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT @map("PENDING")
  PAID            @map("SUCCESS")
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentType {
  CARD
  CASH
}

enum Role {
  Client  @map("role_client")
  Admin   @map("role_admin")
  Manager @map("role_manager")
  Guest   @map("role_guest")

  @@map("roles_enum")
}

enum TokenType {
  VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
  INVITE
}

enum OperatorStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum ChatMode {
  BOT
  WAITING_OPERATOR
  OPERATOR
}

enum SupportCaseStatus {
  WAITING_OPERATOR
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum SupportCaseReason {
  CUSTOMER_REQUEST
  UNSUPPORTED_ACTION
  ASSISTANT_FAILURE
}

enum SenderType {
  USER
  BOT
  OPERATOR
  SYSTEM
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  UNKNOWN
}

enum ConsultationEpisodeStatus {
  OPEN
  CLOSED
}

enum ConsultationEpisodeOutcome {
  PRODUCT_SELECTED
  NO_MATCH
  USER_CANCELLED
  FINISHED_UNSPECIFIED
}

model ConsultationMemoryScope {
  id                   String    @id @default(uuid())
  storeKey             String
  subjectKey           String
  sourceKind           String
  sourceKey            String
  chatId               String?
  memoryEpoch          Int       @default(0)
  purgedThroughSeq     Int       @default(0)
  offerSuppressedUntil DateTime?

  chat     Chat?                     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  episodes ConsultationEpisode[]
  offers   ConsultationResumeOffer[]
  receipts ConsultationTurnReceipt[]

  @@unique([storeKey, subjectKey, sourceKind, sourceKey], map: "consultation_memory_source_key")
  @@unique([storeKey, chatId], map: "consultation_memory_chat_key")
}

model ConsultationEpisode {
  id               String                      @id @default(uuid())
  scopeId          String
  taskKey          String
  type             String                      @default("PRODUCT_SELECTION")
  status           ConsultationEpisodeStatus   @default(OPEN)
  outcome          ConsultationEpisodeOutcome?
  schemaVersion    Int                         @default(1)
  revision         Int                         @default(1)
  contentRevision  Int                         @default(1)
  snapshot         Json
  lastMeaningfulAt DateTime
  expiresAt        DateTime
  closedAt         DateTime?

  scope  ConsultationMemoryScope   @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  offers ConsultationResumeOffer[]

  @@unique([scopeId, taskKey])
  @@index([scopeId, status, lastMeaningfulAt])
  @@index([expiresAt])
}

model ConsultationResumeOffer {
  id              String    @id @default(uuid())
  scopeId         String
  episodeId       String
  episodeRevision Int
  contentRevision Int
  memoryEpoch     Int
  inputSeq        Int
  handoffVersion  Int
  expiresAt       DateTime
  decision        String?
  decidedAt       DateTime?
  consumedAt      DateTime?

  scope   ConsultationMemoryScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  episode ConsultationEpisode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, contentRevision])
  @@index([scopeId, expiresAt])
}

model ConsultationTurnReceipt {
  id                 String   @id @default(uuid())
  scopeId            String
  sourceMessageId    String
  assistantMessageId String
  inputSeq           Int
  payloadHash        String
  appliedRevisions   Json
  expiresAt          DateTime

  scope ConsultationMemoryScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([scopeId, sourceMessageId])
  @@index([expiresAt])
}

model UserContextScope {
  id         String            @id @default(uuid())
  storeKey   String
  subjectKey String
  revision   Int               @default(0)
  facts      UserContextFact[]

  @@unique([storeKey, subjectKey])
}

model UserContextFact {
  id                    String   @id @default(uuid())
  scopeId               String
  domainKey             String
  preferenceKey         String
  value                 Json
  confirmation          String   @default("CONFIRMED")
  commandId             String
  sourceKind            String
  sourceKey             String
  sourceEpisodeId       String
  sourceEpisodeRevision Int
  sourceAttributeId     String
  sourceOperator        String
  observedAt            DateTime
  confirmedAt           DateTime
  updatedAt             DateTime

  scope UserContextScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([scopeId, domainKey, preferenceKey])
  @@index([scopeId, sourceKind, sourceKey, sourceEpisodeId])
}
