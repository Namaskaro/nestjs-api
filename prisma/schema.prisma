model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  size      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, size])
  @@map("cart_item")
}

model Cart {
  id          String     @id @default(uuid())
  userId      String?    @unique
  cartToken   String?    @unique
  totalAmount Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@map("cart")
}

model StoreKnowledge {
  id String @id @default(uuid())

  key String @unique

  section String
  topic   String?

  question String
  answer   String @db.Text

  notice String? @db.Text

  footnote String? @db.Text

  tags String[] @default([])

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, isActive])
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryProvider {
  EMS
  POSTAL
  BOXBERRY
  SDEK
}

enum ConversationMessageRole {
  USER
  ASSISTANT
  OPERATOR
}

enum UserGender {
  MAN    @map("MAN")
  WOMAN  @map("WOMAN")
  UNISEX @map("UNISEX")
}

enum ProductType {
  SHOES       @map("SHOES")
  CLOTHES     @map("CLOTHES")
  ACCESSORIES @map("ACCESSORIES")
}


enum OrderStatus {
  DRAFT
  PENDING_PAYMENT @map("PENDING")
  PAID @map("SUCCESS")
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentType {
  CARD
  CASH
}

enum Role {
  Client  @map("role_client")
  Admin   @map("role_admin")
  Manager @map("role_manager")
  Guest   @map("role_guest")

  @@map("roles_enum")
}

enum TokenType {
  VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
  INVITE
}

enum OperatorStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum ChatMode {
  BOT
  WAITING_OPERATOR
  OPERATOR
}

enum SupportCaseStatus {
  WAITING_OPERATOR
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum SupportCaseReason {
  CUSTOMER_REQUEST
  UNSUPPORTED_ACTION
  ASSISTANT_FAILURE
}

enum SenderType {
  USER
  BOT
  OPERATOR
  SYSTEM
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  UNKNOWN
}
