generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}


model User {
  id                 String           @id @default(uuid())
  name               String?          @default("Не указано")
  email              String?          @unique
  password           String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  role               Role             @default(Client)
  bio                Json?
  image              String           @default("/uploads/no-user-image.png")
  emailVerified      Boolean          @default(false) @map("email_verified")
  isTwoFactorEnabled Boolean          @default(false) @map("is_two_factor_enabled")

  chat            Chat?
  sentMessages    Message[]        @relation("MessageAuthor")
  operatorProfile OperatorProfile?

  supportCases SupportCase[]

  reviews   Review[]
  reviewVotes ReviewVote[]
  accounts  Account[]
  cart      Cart?
  orders    Order[]
  favorites Product[]

  @@map("user")
}

model OperatorProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  status        OperatorStatus @default(AVAILABLE)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inviteExpires DateTime?
  inviteToken   String?        @unique
  availableUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  chats Chat[]

  supportCases SupportCase[]

  @@index([status, isActive])
}

model SupportCase {
  id              String            @id @default(uuid())
  userId          String
  chatId          String
  operatorId      String?
  kind SupportCaseKind @default(GENERAL)

  context Json?
  requestId       String?           @unique
  sourceMessageId String?
  reason          SupportCaseReason
  issue           String            @db.Text
  summary         String?           @db.Text

  status          SupportCaseStatus @default(WAITING_OPERATOR)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  closedAt        DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat     Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  operator OperatorProfile? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([operatorId, status])
  @@index([chatId, createdAt])
  @@index([status, createdAt])
  @@index([chatId, kind, status])
  @@index([kind, status, createdAt])
}

enum SupportCaseKind {
  GENERAL
  HANDOFF
}

model Chat {
  id            String   @id @default(uuid())
  userId        String   @unique
  operatorId    String?
  mode          ChatMode @default(BOT)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  handoffVersion Int @default(0)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator OperatorProfile? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  messages Message[]

  supportCases SupportCase[]

  @@index([operatorId, mode])
  @@index([mode, lastMessageAt])
}

model Message {
  id        String                  @id @default(uuid())
  chatId    String
  authorId  String?
  role      ConversationMessageRole
  content   String                  @db.Text
  payload   Json?
  createdAt DateTime                @default(now())

  chat   Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User? @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@index([authorId])
}

model Token {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  @@map("tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model Product {
  id            String       @id @default(uuid())
  title         String
  description   String
  price         String
  images        String[]
  subcategoryId String?      @map("subcategory_id")
  brandId       String?      @map("brand_id")
  userId        String?      @map("user_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  gender        UserGender
  type          ProductType
  blurURL       String[]     @default([])
  sizes         String[]     @default([])
  color         String?
  discount      String?      @default("0")
  isNew         Boolean?
  inStock       Boolean      @default(true)
  stock         Int          @default(10)
  details       String[]     @default([])
  reviews       Review[]
  reviewSummary ReviewSummary?
  cartItems     CartItem[]
  brand         Brand?       @relation(fields: [brandId], references: [id])
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  embedding ProductEmbedding?

  @@index([id])
  @@map("product")
}

model ProductEmbedding {
  productId String @id
  vector    Unsupported("vector(768)")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  slug          String?       @unique
  subcategories Subcategory[]

  @@map("category")
}

model Subcategory {
  id         String     @id @default(uuid())
  name       String     @unique
  categoryId String     @map("category_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  imageUrl   String
  gender     UserGender
  slug       String?
  products   Product[]
  category   Category   @relation(fields: [categoryId], references: [id])

  @@map("subcategory")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  coverImg  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
}

model Review {
  id        String   @id @default(uuid())
  text      String
  rating    Int
  userId    String?  @map("user_id")
  productId String?  @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product? @relation(fields: [productId], references: [id])
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  publicationId          String                 @unique @default(uuid())
  status                 ReviewModerationStatus @default(PENDING)
  submittedAt            DateTime               @default(now())
  publishedAt            DateTime?
  moderatedAt            DateTime?
  moderatedBy            String?
  moderationReason       String?
  verifiedOrderId        String?
  verifiedAt             DateTime?
  deletedAt              DateTime?
  stateVersion           Int                    @default(0)
  publishedCorpusVersion Int?
  upVotes                Int                    @default(0)
  downVotes              Int                    @default(0)
  popularityScore        Int                    @default(0)
  indexPending           Boolean                @default(false)
  indexNextAttemptAt     DateTime?
  indexLeaseToken        String?
  indexLeaseUntil        DateTime?
  indexAttempts          Int                    @default(0)
  addenda                ReviewAddendum[]
  votes                  ReviewVote[]

  @@unique([userId, productId])
  @@index([productId, status, deletedAt, publishedAt, id])
  @@index([productId, status, deletedAt, rating, publishedAt, id])
  @@index([productId, status, deletedAt, popularityScore, publishedAt, id])
  @@index([status, submittedAt, id])
  @@index([indexPending, indexNextAttemptAt])
}

enum ReviewModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum ReviewVoteValue {
  UP
  DOWN
}

model ReviewAddendum {
  id                     String                 @id @default(uuid())
  reviewId               String
  publicationId          String
  text                   String
  status                 ReviewModerationStatus @default(PENDING)
  createdAt              DateTime               @default(now())
  publishedAt            DateTime?
  moderatedAt            DateTime?
  moderatedBy            String?
  moderationReason       String?
  publishedCorpusVersion Int?
  review                 Review                 @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, publicationId, status, createdAt, id])
  @@index([status, createdAt, id])
}

model ReviewVote {
  reviewId      String
  userId        String
  publicationId String
  value         ReviewVoteValue
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  review        Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model ReviewSummary {
  productId             String   @id
  positiveImpressions   String[] @default([])
  negativeImpressions   String[] @default([])
  summary               String?
  generatedAt           DateTime?
  sourceReviewCount     Int      @default(0)
  sourceAuthorCount     Int      @default(0)
  corpusVersion         Int      @default(0)
  requestedVersion      Int      @default(0)
  sourceVersion         Int      @default(0)
  lastRetractionVersion Int      @default(0)
  sourceHash            String?
  analyzerVersion       String?
  nextAttemptAt         DateTime?
  leaseToken            String?
  leaseUntil            DateTime?
  attemptCount          Int      @default(0)
  lastErrorCode         String?
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt, leaseUntil])
}

model PromoCode {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  isActive      Boolean      @default(true)
  expiresAt     DateTime?

  @@map("promocode")
}

