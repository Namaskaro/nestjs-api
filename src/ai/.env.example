# AI only. Merge into existing environment; preserve working Yandex URIs/auth.
# Authoritative guide: docs/AI_PROVIDERS.md
CHAT_MODE=direct
CHAT_FAST=yandex-lite
CHAT_STANDARD=yandex-standard
CHAT_FAST_FALLBACK=qwen-flash
CHAT_STANDARD_FALLBACK=qwen-max
CHAT_REQUEST_TIMEOUT_MS=60000
POLZA_API_KEY=
YANDEX_API_KEY=
YANDEX_API_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_LITE_MODEL=gpt://YOUR_FOLDER/yandexgpt-lite/latest
YANDEX_MODEL=gpt://YOUR_FOLDER/yandexgpt/latest

# Named CHAT_<ROLE> overrides that role's legacy PROVIDER/MODEL/TRANSPORT_PROFILE.
# Named CHAT_<ROLE>_FALLBACK likewise overrides legacy FALLBACK_* fields.
# Primary-only: REMOVE both named and legacy FALLBACK variables (do not leave blank).
# Alternative: CHAT_FAST=qwen-flash, CHAT_STANDARD=qwen-max
# Alternative: CHAT_FAST=gpt-6-luna, CHAT_STANDARD=gpt-6.1-sol
# OPENAI_API_KEY=
# Alternative: CHAT_STANDARD=gigachat-2 (see known live limitations in the guide).
# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# NODE_EXTRA_CA_CERTS=<trusted PEM path> or a Node runtime supporting --use-system-ca
# Legacy direct Alibaba still uses QWEN_API_KEY/QWEN_API_URL and qwen-chat profile.
# Polza uses POLZA_API_KEY and polza-chat, WITHOUT enable_thinking.

# Independent embeddings. KEEP the actual working primary settings unchanged.
EMBEDDING_PROVIDER=yandex
EMBEDDING_FAILOVER_ENABLED=false
EMBEDDING_FALLBACK_PROVIDER=qwen
EMBEDDING_REQUEST_TIMEOUT_MS=60000
QDRANT_REQUEST_TIMEOUT_MS=60000
# Keep existing Yandex query/document URIs and auth (default iam/Bearer).
# YANDEX_FOLDER_ID=<existing folder>
# YANDEX_EMBEDDING_QUERY_MODEL=<existing query model URI>
# YANDEX_EMBEDDING_DOCUMENT_MODEL=<existing document model URI>
# YANDEX_EMBEDDING_DIMENSIONS=768
# YANDEX_EMBEDDING_AUTH_TYPE=api-key
QWEN_EMBEDDING_MODEL=qwen/qwen3-embedding-4b
QWEN_EMBEDDING_DIMENSIONS=2560
# 8B alternative: model=qwen/qwen3-embedding-8b, expected dimensions=4096.
# Dimensions are checked locally; the Polza request DOES NOT send dimensions.
QDRANT_PRODUCTS_SECONDARY_COLLECTION=products_fallback
QDRANT_KNOWLEDGE_SECONDARY_COLLECTION=store_knowledge_fallback
# Enable failover only after approved reindex + complete --verify.
# Reconciliation does not load .env automatically: use node --env-file=.env ...
# ALLOW_EMBEDDING_REINDEX is an operator-only apply guard, not a permanent app setting.
