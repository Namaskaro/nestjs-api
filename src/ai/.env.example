# AI settings only. Merge with existing app environment; never commit real keys.
CHAT_MODE=direct
CHAT_FAST_PROVIDER=qwen
CHAT_FAST_MODEL=qwen3.7-flash-2026-07-15
CHAT_STANDARD_PROVIDER=openai
CHAT_STANDARD_MODEL=gpt-6.1-sol
CHAT_REQUEST_TIMEOUT_MS=60000
OPENAI_API_KEY=
QWEN_API_KEY=
# Copy the compatible-mode base URL from your own region/workspace console.
QWEN_API_URL=https://YOUR_WORKSPACE.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Either role can independently use yandex/openai/qwen/gigachat. Restart after changes.
# Yandex alternative: CHAT_STANDARD_PROVIDER=yandex
# CHAT_STANDARD_MODEL=gpt://YOUR_FOLDER/yandexgpt/latest
YANDEX_API_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_API_KEY=

# Embeddings are independent. KEEP your existing model URIs/dimensions/credentials.
# Do not change an embedding model against an existing index without reindexing.
EMBEDDING_PROVIDER=yandex
# YANDEX_FOLDER_ID=<existing folder>
# YANDEX_EMBEDDING_QUERY_MODEL=<existing query model URI>
# YANDEX_EMBEDDING_DOCUMENT_MODEL=<existing document model URI>
# YANDEX_EMBEDDING_DIMENSIONS=768
# OpenAI embeddings, only after a separately reviewed index migration:
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=768

# Optional LLM fallback: absent by default; enable only after live conformance.
# CHAT_FAST_FALLBACK_PROVIDER=qwen
# CHAT_FAST_FALLBACK_MODEL=<approved deployment>
# CHAT_STANDARD_FALLBACK_PROVIDER=yandex
# CHAT_STANDARD_FALLBACK_MODEL=gpt://YOUR_FOLDER/<approved model>
# For custom OpenAI aliases: CHAT_<ROLE>[_FALLBACK]_TRANSPORT_PROFILE=gpt-6-luna or gpt-6.1-sol

# GigaChat native v1 is implemented; live schema/OAuth/CA conformance is still required.
# CHAT_STANDARD_PROVIDER=gigachat
# CHAT_STANDARD_MODEL=GigaChat-2
# GIGACHAT_CREDENTIALS=<OAuth authorization key>
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# NODE_EXTRA_CA_CERTS=<trusted CA PEM path; never disable TLS verification>

# Embedding request bounds apply with failover off too. No automatic migration.
EMBEDDING_FAILOVER_ENABLED=false
EMBEDDING_REQUEST_TIMEOUT_MS=60000
QDRANT_REQUEST_TIMEOUT_MS=60000
# YANDEX_EMBEDDING_AUTH_TYPE=iam  # use api-key explicitly for an API key
# Secondary settings only after approved migration; keep primary dimensions unchanged:
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# QDRANT_PRODUCTS_SECONDARY_COLLECTION=products_openai_v1
# QDRANT_KNOWLEDGE_SECONDARY_COLLECTION=knowledge_openai_v1
# Maintenance prune is OFF by default, even with --apply. Separate exact confirmation:
# EMBEDDING_PRUNE_COLLECTION=<one configured collection>
# EMBEDDING_PRUNE_MAX_POINTS=<approved limit 1..1000; empty source is always refused>
